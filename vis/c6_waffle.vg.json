{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "A 100-cell waffle chart showing the normalized composition of the fixed grocery panel.",
  "width": 800,
  "height": 520,
  "layer": [
    {
      "data": {
        "url": "data/c6_waffle.csv"
      },
      "transform": [
        {
          "calculate": "datum.group === 'Protein' ? 1 : datum.group === 'Staples' ? 2 : datum.group === 'Fresh produce' ? 3 : 4",
          "as": "group_order"
        },
        {
          "window": [
            {
              "op": "sum",
              "field": "cells",
              "as": "cum_cells"
            }
          ],
          "sort": [
            {
              "field": "group_order",
              "order": "ascending"
            }
          ]
        },
        {
          "calculate": "datum.cum_cells - datum.cells",
          "as": "start_cell"
        },
        {
          "calculate": "sequence(datum.start_cell, datum.cum_cells)",
          "as": "cell_id"
        },
        {
          "flatten": [
            "cell_id"
          ]
        },
        {
          "calculate": "floor(datum.cell_id / 10)",
          "as": "col"
        },
        {
          "calculate": "datum.cell_id % 10",
          "as": "row"
        }
      ],
      "mark": {
        "type": "square",
        "filled": true,
        "size": 1800,
        "stroke": "#ffffff",
        "strokeWidth": 1.6,
        "cursor": "pointer"
      },
      "encoding": {
        "x": {
          "field": "col",
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.5,
              15.5
            ]
          },
          "axis": null
        },
        "y": {
          "field": "row",
          "type": "quantitative",
          "scale": {
            "domain": [
              9.5,
              -1.5
            ]
          },
          "axis": null
        },
        "color": {
          "field": "group",
          "type": "nominal",
          "scale": {
            "domain": [
              "Protein",
              "Staples",
              "Fresh produce",
              "Packaged"
            ],
            "range": [
              "#203864",
              "#2A9D8F",
              "#E9C46A",
              "#8E5D7A"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "group",
            "type": "nominal",
            "title": "Product group"
          },
          {
            "field": "cells",
            "type": "quantitative",
            "title": "Squares"
          },
          {
            "field": "share_pct",
            "type": "quantitative",
            "title": "Share of panel (%)",
            "format": ".1f"
          },
          {
            "field": "items",
            "type": "nominal",
            "title": "Included products"
          }
        ]
      }
    },
    {
      "data": {
