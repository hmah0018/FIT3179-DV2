{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "description": "Year-on-year inflation across six Malaysian CPI food subclasses, shown as small-multiple monthly time series.",

  "data": {
    "url": "data/c5_cpi_food_subclasses.csv"
  },

  "transform": [
    {
      "calculate": "toDate(datum.date + '-01')",
      "as": "date_parsed"
    },
    {
      "window": [
        {
          "op": "lag",
          "field": "index",
          "param": 12,
          "as": "index_prev_year"
        }
      ],
      "sort": [
        {
          "field": "date_parsed",
          "order": "ascending"
        }
      ],
      "groupby": [
        "group"
      ]
    },
    {
      "calculate": "datum.index_prev_year == null ? null : ((datum.index / datum.index_prev_year) - 1) * 100",
      "as": "yoy"
    },
    {
      "filter": "datum.yoy != null"
    },
    {
      "filter": "year(datum.date_parsed) >= 2022"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "yoy",
          "as": "peak_yoy"
        }
      ],
      "groupby": [
        "group"
      ]
    }
  ],

  "facet": {
    "field": "group",
    "type": "nominal",

    "sort": [
      "Rice & cereals",
      "Meat (incl. chicken)",
      "Fresh fish",
      "Eggs",
      "Vegetable oils",
      "Leafy vegetables"
    ],

    "header": {
      "title": null,
      "labelColor": "#183153",
      "labelFontSize": 11,
      "labelFontWeight": 700,
      "labelPadding": 8,
      "labelLimit": 180
    }
  },

  "columns": 2,

  "spec": {
    "width": 185,
    "height": 150,

    "layer": [
      {
        "mark": {
          "type": "rule",
          "stroke": "#b8bec6",
          "strokeWidth": 1,
          "strokeDash": [3, 3]
        },

        "encoding": {
          "y": {
            "datum": 0
          }
        }
      },

      {
        "mark": {
          "type": "line",
          "stroke": "#596b7f",
          "strokeWidth": 2.1,
          "interpolate": "linear"
        },

        "encoding": {
          "x": {
            "field": "date_parsed",
            "type": "temporal",

            "axis": {
              "title": null,
              "format": "%Y",
              "labelFontSize": 8,
              "labelColor": "#68717d",
              "labelAngle": 0,
              "tickCount": "year",
              "grid": false,
              "domainColor": "#aeb7c0",
              "tickColor": "#aeb7c0"
            }
          },

          "y": {
            "field": "yoy",
            "type": "quantitative",

            "scale": {
              "zero": false
            },

            "axis": {
              "title": null,
              "labelFontSize": 8,
              "labelColor": "#68717d",
              "format": ".0f",
              "grid": true,
              "gridColor": "#e8e5df",
              "gridOpacity": 0.75,
              "domain": false,
              "ticks": false
            }
          },

          "tooltip": [
            {
              "field": "group",
              "type": "nominal",
              "title": "Food category"
            },
            {
              "field": "date_parsed",
              "type": "temporal",
              "title": "Month",
              "format": "%b %Y"
            },
            {
              "field": "yoy",
              "type": "quantitative",
              "title": "Inflation (%)",
              "format": ".1f"
            },
            {
              "field": "index",
              "type": "quantitative",
              "title": "CPI index",
              "format": ".1f"
            }
          ]
        }
      },

      {
        "mark": {
          "type": "point",
          "filled": true,
          "size": 70,
          "fill": "#ffffff",
          "stroke": "#596b7f",
          "strokeWidth": 1.5,
          "opacity": 0.001
        },

        "encoding": {
          "x": {
            "field": "date_parsed",
            "type": "temporal"
          },

          "y": {
            "field": "yoy",
            "type": "quantitative"
          },

          "tooltip": [
            {
              "field": "group",
              "type": "nominal",
              "title": "Food category"
            },
            {
              "field": "date_parsed",
              "type": "temporal",
              "title": "Month",
              "format": "%b %Y"
            },
            {
              "field": "yoy",
              "type": "quantitative",
              "title": "Inflation (%)",
              "format": ".1f"
            }
          ]
        }
      },

      {
        "transform": [
          {
            "filter": "datum.yoy == datum.peak_yoy"
          }
        ],

        "mark": {
          "type": "point",
          "filled": true,
          "size": 75,
          "fill": "#d97732",
          "stroke": "#ffffff",
          "strokeWidth": 1.5
        },

        "encoding": {
          "x": {
            "field": "date_parsed",
            "type": "temporal"
          },

          "y": {
            "field": "yoy",
            "type": "quantitative"
          },

          "tooltip": [
            {
              "field": "group",
              "type": "nominal",
              "title": "Food category"
            },
            {
              "field": "date_parsed",
              "type": "temporal",
              "title": "Peak month",
              "format": "%b %Y"
            },
            {
              "field": "yoy",
              "type": "quantitative",
              "title": "Peak inflation (%)",
              "format": ".1f"
            }
          ]
        }
      }
    ]
  },

  "resolve": {
    "scale": {
      "x": "shared",
      "y": "shared"
    }
  },

  "config": {
    "background": null,

    "view": {
      "stroke": null
    },

    "facet": {
      "spacing": 20
    },

    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial"
    },

    "header": {
      "labelFont": "Arial"
    }
  }
}