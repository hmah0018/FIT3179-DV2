{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "description": "Latest year-on-year Malaysian CPI inflation by division, highlighting food and comparing each division with overall CPI.",

  "width": "container",
  "height": 310,

  "data": {
    "url": "data/c2_divisions_latest.csv"
  },

  "transform": [
    {
      "calculate": "datum.name === 'Personal Care, Social Protection & Miscellaneous Goods & Services' ? 'Personal care & misc.' : datum.name === 'Alcoholic Beverages & Tobacco' ? 'Alcohol & tobacco' : datum.name === 'Information & Communication' ? 'Information & comms.' : datum.name === 'Housing, Water, Electricity, Gas & Other Fuels' ? 'Housing & utilities' : datum.name === 'Restaurant & Accommodation Services' ? 'Restaurants & hotels' : datum.name === 'Food & Beverages' ? 'Food & beverages' : datum.name === 'Recreation, Sport & Culture' ? 'Recreation & culture' : datum.name === 'Insurance & Financial Services' ? 'Insurance & finance' : datum.name === 'Furnishings, Household Equipment & Routine Household Maintenance' ? 'Household furnishings' : datum.name === 'Clothing & Footwear' ? 'Clothing & footwear' : datum.name",
      "as": "short_name"
    }
  ],

  "layer": [
    {
      "transform": [
        {
          "filter": "datum.name !== 'All items'"
        }
      ],

      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 3,
        "height": {
          "band": 0.68
        }
      },

      "encoding": {
        "y": {
          "field": "short_name",
          "type": "nominal",

          "sort": {
            "field": "yoy",
            "op": "max",
            "order": "descending"
          },

          "axis": {
            "title": null,
            "labelFontSize": 10,
            "labelColor": "#435166",
            "labelLimit": 155,
            "ticks": false,
            "domain": false
          }
        },

        "x": {
          "field": "yoy",
          "type": "quantitative",

          "scale": {
            "domain": [0, 3.7]
          },

          "axis": {
            "title": "Year-on-year inflation (%)",
            "titleFontSize": 10,
            "titlePadding": 10,

            "labelFontSize": 10,

            "values": [0, 1, 2, 3],

            "grid": true,
            "gridColor": "#e8e5df",
            "gridOpacity": 0.8,

            "domain": true,
            "domainColor": "#9ba6b2",
            "domainWidth": 1,

            "ticks": true,
            "tickColor": "#9ba6b2",
            "tickSize": 4
          }
        },

        "color": {
          "condition": {
            "test": "datum.name === 'Food & Beverages'",
            "value": "#183153"
          },
          "value": "#a6b7c9"
        },

        "tooltip": [
          {
            "field": "name",
            "type": "nominal",
            "title": "CPI division"
          },
          {
            "field": "date",
            "type": "nominal",
            "title": "Month"
          },
          {
            "field": "yoy",
            "type": "quantitative",
            "title": "Inflation (%)",
            "format": ".2f"
          }
        ]
      }
    },

    {
      "transform": [
        {
          "filter": "datum.name !== 'All items'"
        },
        {
          "calculate": "format(datum.yoy, '.1f') + '%'",
          "as": "yoy_label"
        }
      ],

      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 5,
        "fontSize": 10,
        "fontWeight": 600
      },

      "encoding": {
        "y": {
          "field": "short_name",
          "type": "nominal",

          "sort": {
            "field": "yoy",
            "op": "max",
            "order": "descending"
          }
        },

        "x": {
          "field": "yoy",
          "type": "quantitative"
        },

        "text": {
          "field": "yoy_label"
        },

        "color": {
          "condition": {
            "test": "datum.name === 'Food & Beverages'",
            "value": "#183153"
          },
          "value": "#7f93a8"
        }
      }
    },

    {
      "data": {
        "values": [
          {
            "overall": 1.93
          }
        ]
      },

      "mark": {
        "type": "rule",
        "stroke": "#6b7280",
        "strokeWidth": 1.4,
        "strokeDash": [5, 4]
      },

      "encoding": {
        "x": {
          "field": "overall",
          "type": "quantitative",

          "scale": {
            "domain": [0, 3.7]
          }
        }
      }
    },

    {
      "data": {
        "values": [
          {
            "overall": 1.93,
            "label": "Overall CPI 1.9%"
          }
        ]
      },

      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "dx": 5,
        "dy": 4,
        "fontSize": 9,
        "fontWeight": "bold",
        "color": "#6b7280"
      },

      "encoding": {
        "x": {
          "field": "overall",
          "type": "quantitative",

          "scale": {
            "domain": [0, 3.7]
          }
        },

        "y": {
          "value": 2
        },

        "text": {
          "field": "label"
        }
      }
    },

    {
      "transform": [
        {
          "filter": "datum.name === 'Food & Beverages'"
        }
      ],

      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 38,
        "fontSize": 9,
        "fontStyle": "italic",
        "color": "#183153"
      },

      "encoding": {
        "y": {
          "field": "short_name",
          "type": "nominal",

          "sort": {
            "field": "yoy",
            "op": "max",
            "order": "descending"
          }
        },

        "x": {
          "field": "yoy",
          "type": "quantitative"
        },

        "text": {
          "value": "← food"
        }
      }
    }
  ],

  "config": {
    "background": null,

    "view": {
      "stroke": null
    },

    "axis": {
      "labelColor": "#435166",
      "titleColor": "#435166"
    }
  }
}